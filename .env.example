# ------------------------------------------------------------------

# Local testing template — copy to .env and fill in your values.

# (GitHub Actions uses repository Secrets/Variables instead — see README.)

# ------------------------------------------------------------------

# Optional catch-all fallback webhook (only used for accounts/subs without their own secret)

DISCORD_WEBHOOK_URL=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

# Comma-separated list of X (Twitter) handles to track

ACCOUNTS=TYPEII_EN,PomPom_HonkaiSR,Wuthering_Waves,HonkaiNA,Ananta_EN

# One webhook per account (rule: WEBHOOK_ + account name uppercased)

WEBHOOK_TYPEII_EN=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_POMPOM_HONKAISR=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_WUTHERING_WAVES=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_HONKAINA=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_ANANTA_EN=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

# Comma-separated subreddits to track

SUBREDDITS=Zenlesszonezeroleaks_,Genshin_Impact_Leaks,HonkaiStarRail_leaks,WutheringWavesLeaks,HonkaiNexusAnimaLeaks,AnantaLeaks

# One webhook per subreddit (rule: WEBHOOK_REDDIT_ + sub name uppercased)

WEBHOOK_REDDIT_ZENLESSZONEZEROLEAKS_=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_REDDIT_GENSHIN_IMPACT_LEAKS=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_REDDIT_HONKAISTARRAIL_LEAKS=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_REDDIT_WUTHERINGWAVESLEAKS=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_REDDIT_HONKAINEXUSANIMALEAKS=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

WEBHOOK_REDDIT_ANANTALEAKS=[https://discord.com/api/webhooks/](https://discord.com/api/webhooks/)...

# Optional (V1 only): embed mirror host — [redditez.com](http://redditez.com) | [embeddit.deltandy.me](http://embeddit.deltandy.me) | [vxreddit.com](http://vxreddit.com)

REDDIT_MIRROR=[redditez.com](http://redditez.com)

# Reddit V2 only (from your [embedez.com](http://embedez.com) dashboard)

EMBEDEZ_API_KEY=ez_...

# Reddit feed token — RECOMMENDED (V1 + V2). Anonymous Reddit RSS from
# datacenter IPs is limited to ~1 request/minute per IP since June 2026;
# the token (below) moves requests to the logged-in rate tier.
# Get it: old.reddit.com -> Preferences -> Feeds -> copy the "?feed=..."
# value from any feed link (the token itself, without "?feed=").
# On GitHub this is the REDDIT_FEED_TOKEN secret.

REDDIT_FEED_TOKEN=
